# 此文件只展示变量名称，不要在 Git 中提交真实密码或密钥。
DB_URL=jdbc:mysql://localhost:3306/edumix?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=请填写本机MySQL密码

# 至少 32 字节随机内容经过 Base64 编码，例如：openssl rand -base64 32
JWT_SECRET=请填写Base64编码的JWT密钥

AI_CHAT_PROVIDER=openai
AI_API_KEY=请填写AI接口密钥
AI_BASE_URL=https://api.openai.com
AI_MODEL=gpt-4o-mini
EDUMIX_UPLOAD_DIR=uploads
